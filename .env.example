# Development: keep API same-origin via Vite proxy.
VITE_DEV_PROXY_TARGET=http://localhost:5000
# Production: use /api behind the same-origin reverse proxy, or set an allowed HTTPS API URL.
VITE_API_BASE_URL=/api
# Optional: WebSocket server origin when /socket.io is NOT reverse-proxied on the frontend host.
# E.g. https://api.example.com; defaults to VITE_API_BASE_URL host or same origin.
VITE_SOCKET_URL=
